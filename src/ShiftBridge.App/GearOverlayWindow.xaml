<Window x:Class="ShiftBridge.App.GearOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:Strings.Overlay_Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Frame" CornerRadius="12" Padding="18,8,18,10" BorderBrush="#55FFFFFF" BorderThickness="1">
        <!-- Seul le fond est translucide (réglage d'opacité) : le texte et la barre restent lisibles. -->
        <Border.Background>
            <SolidColorBrush Color="#101418" Opacity="{Binding OverlayOpacity}" />
        </Border.Background>
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding OverlayScale}" ScaleY="{Binding OverlayScale}" />
        </Border.LayoutTransform>
        <StackPanel>
            <TextBlock Text="{Binding OverlayGear}" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding OverlayDetail}" FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />

            <!-- Barre des vitesses : le cran courant est plus haut et en couleur d'accent -->
            <ItemsControl ItemsSource="{Binding OverlaySegments}" Margin="0,8,0,0" HorizontalAlignment="Center"
                          Visibility="{Binding OverlayShowBar, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="5" Margin="1,0" CornerRadius="1.5" VerticalAlignment="Bottom">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="Background" Value="#33FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBelow}" Value="True">
                                            <Setter Property="Background" Value="#88FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Background" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Puissance · cadence · vitesse du trainer (option) -->
            <TextBlock Text="{Binding OverlayTelemetry}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="{Binding OverlayTelemetry, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </Border>
</Window>
