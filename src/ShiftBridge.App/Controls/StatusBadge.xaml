<UserControl x:Class="ShiftBridge.App.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" VerticalAlignment="Center" HorizontalAlignment="Left">
    <!-- Pastille d'état : la couleur ne suffit pas (daltonisme), le symbole dit la même chose -->
    <Border x:Name="Disc" Width="18" Height="18" CornerRadius="9">
        <TextBlock x:Name="Glyph" FontFamily="Segoe UI Symbol" FontSize="11" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
    </Border>
</UserControl>
