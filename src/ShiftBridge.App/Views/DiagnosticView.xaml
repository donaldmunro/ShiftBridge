<UserControl x:Class="ShiftBridge.App.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="36,30,36,30">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="{x:Static loc:Strings.Settings_BackToSettings}" Command="{Binding NavigateCommand}" CommandParameter="settings"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-16,-8,0,6" />
            <TextBlock Text="{x:Static loc:Strings.Nav_Diagnostic}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                       Text="{x:Static loc:Strings.Diag_Intro}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{x:Static loc:Strings.Diag_Copy}" Command="{Binding CopyLogCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:Strings.Diag_Clear}" Command="{Binding ClearLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,20,0" />
                <CheckBox Content="{x:Static loc:Strings.Diag_Verbose}" IsChecked="{Binding VerboseFrames}" VerticalAlignment="Center" />
            </StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Diag_AddNote}" Command="{Binding AddNoteCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static loc:Strings.Diag_NoteTip}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddNoteCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource Sidebar}" Foreground="{StaticResource TextMuted}" Padding="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</UserControl>
